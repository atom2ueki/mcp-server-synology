# Synology MCP Server Configuration
# Copy this file to .env and fill in your values

# Required: Synology NAS connection details
SYNOLOGY_URL=https://192.168.1.100:5001
SYNOLOGY_USERNAME=your_username
SYNOLOGY_PASSWORD=your_password

# Optional: 2FA / OTP (one-shot, first login only — for persistent reuse,
# migrate to ~/.config/synology-mcp/settings.json and store `device_id` per-NAS)
# SYNOLOGY_OTP_CODE=123456

# Optional: Server settings
MCP_SERVER_NAME=synology-mcp-server
MCP_SERVER_VERSION=1.0.0

# Optional: Session and security settings
SESSION_TIMEOUT=3600
AUTO_LOGIN=false
VERIFY_SSL=false  # Set to true if your NAS has valid SSL certificate

# Optional: Debug settings
DEBUG=false
LOG_LEVEL=INFO 

# Optional: Audit trail (see "Audit trail and tool annotations" in README)
# Every tool call is appended as one JSON line (args redacted, path recorded).
# A destructive tool refuses to run when the trail cannot be written.
MCP_AUDIT=true
MCP_AUDIT_LOG=logs/audit.jsonl
MCP_AUDIT_MAX_BYTES=10485760
MCP_AUDIT_KEEP=5

# Optional: confine File Station writes to these absolute paths, comma-separated.
# Empty means every share. Applies to create/delete/copy/move/rename; a move
# checks both ends, since removing the source is a write too. Share and volume
# roots are always refused as write targets.
MCP_FILESTATION_ROOTS=/volume1/media,/volume1/backups

# Optional: least privilege at the server. `full` exposes every tool;
# `no_destructive` hides delete/overwrite/remove tools; `read_only` exposes
# read-only tools only. Withheld tools are absent from tools/list.
MCP_TOOL_PROFILE=full

# Optional: confirmation for destructive tools.
#   mrtr  — require the MCP 2026-07-28 confirmation form; unsupported clients refuse
#   off   — no confirmation (the audit trail still records the call)
MCP_CONFIRM=mrtr
MCP_CONFIRM_TTL_SECONDS=300
# MCP_CONFIRM_SECRET=change-me            # optional; otherwise generated once
# MCP_CONFIRM_SECRET_FILE=logs/.confirm-secret

# Optional: soft delete. `auto` moves the target into <share>/#trash when the
# share can host it and falls back to a normal delete when it cannot.
MCP_TRASH=auto
# Folder name under the share, or an absolute template with {share} for shares
# whose root the MCP account cannot write:
MCP_TRASH_DIR=#trash

# Xiaozhi MCP Integration (optional)
# Set to true to enable both Xiaozhi (WebSocket) and Claude/Cursor (stdio) support
# Set to false or omit for Claude/Cursor only mode
ENABLE_XIAOZHI=false
XIAOZHI_TOKEN=your_xiaozhi_token_here
XIAOZHI_MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/