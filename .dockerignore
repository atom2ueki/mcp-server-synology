# .dockerignore - Exclude files from Docker build context

# Virtual environment
.venv/
venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore

# Secrets - never into the build context. (env.example has no leading dot and
# is not matched here; it is the checked-in template and carries no values.)
.env
.env.*

# Documentation and assets
README.md
*.md
assets/

# Docker files (don't need them inside container)
Dockerfile
docker-compose.yml
.dockerignore

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Test files
test_*
*_test.py 